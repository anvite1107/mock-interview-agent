  "difficulty": "medium",
  "prompt": "Given an array of integers nums and an integer k, return the total number of contiguous subarrays whose sum equals k.",
  "functionSignature": "def solution(nums: List[int], k: int) -> int:",
  "constraints": ["1 <= len(nums) <= 2 * 10^4", "-1000 <= nums[i] <= 1000", "-10^7 <= k <= 10^7"],
  "referenceComplexity": { "time": "O(n)", "space": "O(n)" },
  "testCases": [
    { "id": "core-1", "input": [[1, 1, 1], 2], "expectedOutput": 2, "tag": "core" },
    { "id": "core-2", "input": [[1, 2, 3], 3], "expectedOutput": 2, "tag": "core" },
    { "id": "core-3", "input": [[1, -1, 0], 0], "expectedOutput": 3, "tag": "core" },
    { "id": "edge-1", "input": [[1], 0], "expectedOutput": 0, "tag": "edge" },
    { "id": "edge-2", "input": [[-1, -1, 1], 0], "expectedOutput": 1, "tag": "edge" },
