{
  "id": "two-sum",
  "title": "Two Sum",
  "difficulty": "easy",
  "prompt": "Given an array of integers `nums` and an integer `target`, return the indices of the two numbers such that they add up to `target`. You may assume that each input has exactly one solution, and you may not use the same element twice. Return the indices in ascending order.",
  "functionSignature": "def solution(nums: List[int], target: int) -> List[int]:",
  "constraints": [
    "2 <= len(nums) <= 10^4",
    "-10^9 <= nums[i] <= 10^9",
    "-10^9 <= target <= 10^9",
    "Exactly one valid answer exists for each input"
  ],
  "referenceComplexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "testCases": [
    {
      "id": "core-1",
      "input": [[2, 7, 11, 15], 9],
      "expectedOutput": [0, 1],
      "tag": "core"
    },
    {
      "id": "core-2",
      "input": [[3, 2, 4], 6],
      "expectedOutput": [1, 2],
      "tag": "core"
    },
    {
      "id": "core-3",
      "input": [[1, 5, 3, 8], 11],
      "expectedOutput": [2, 3],
      "tag": "core"
    },
    {
      "id": "edge-1",
      "input": [[3, 3], 6],
      "expectedOutput": [0, 1],
      "tag": "edge"
    },
    {
      "id": "edge-2",
      "input": [[-1, -2, -3, -4, -5], -8],
      "expectedOutput": [2, 4],
      "tag": "edge"
    },
    {
      "id": "edge-3",
      "input": [[0, 4, 3, 0], 0],
      "expectedOutput": [0, 3],
      "tag": "edge"
    },
    {
      "id": "edge-4",
      "input": [[1000000000, 999999999, 1], 1000000000],
      "expectedOutput": [1, 2],
      "tag": "edge"
    }
  ]
}
