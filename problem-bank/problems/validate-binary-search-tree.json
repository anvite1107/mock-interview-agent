{
  "id": "validate-binary-search-tree",
  "title": "Validate Binary Search Tree",
  "difficulty": "medium",
  "prompt": "Given the root of a binary tree, determine if it is a valid binary search tree (BST). A valid BST is defined as: the left subtree contains only nodes with values strictly less than the node's value; the right subtree contains only nodes with values strictly greater than the node's value; both subtrees must also be valid BSTs.",
  "functionSignature": "def solution(root: TreeNode) -> bool:",
  "constraints": ["0 <= number of nodes <= 10^4", "-2^31 <= Node.val <= 2^31 - 1"],
  "referenceComplexity": { "time": "O(n)", "space": "O(h)" },
  "inputStructures": ["tree"],
  "testCases": [
    { "id": "core-1", "input": [[2, 1, 3]], "expectedOutput": true, "tag": "core" },
    { "id": "core-2", "input": [[5, 3, 7, 2, 4, 6, 8]], "expectedOutput": true, "tag": "core" },
    { "id": "core-3", "input": [[5, 1, 4, null, null, 3, 6]], "expectedOutput": false, "tag": "core" },
    { "id": "edge-1", "input": [[1]], "expectedOutput": true, "tag": "edge" },
    { "id": "edge-2", "input": [[]], "expectedOutput": true, "tag": "edge" },
    { "id": "edge-3", "input": [[1, 1]], "expectedOutput": false, "tag": "edge" },
    { "id": "edge-4", "input": [[10, 5, 15, null, null, 6, 20]], "expectedOutput": false, "tag": "edge" }
  ]
}